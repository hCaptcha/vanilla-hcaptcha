{
  "name": "@hcaptcha/vanilla-hcaptcha",
  "description": "Vanilla Web Component for hCaptcha. 0 dependencies. <1kb gzipped.",
  "version": "1.1.4",
  "main": "dist/index.min.js",
  "module": "dist/index.min.mjs",
  "types": "dist/hcaptcha.d.ts",
  "author": "hCaptcha team and contributors",
  "homepage": "https://github.com/hCaptcha/vanilla-hcaptcha",
  "organization": "hCaptcha",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hCaptcha/vanilla-hcaptcha.git",
    "web": "https://github.com/hCaptcha/vanilla-hcaptcha"
  },
  "files": [
    "dist",
    "src",
    "demo.html"
  ],
  "scripts": {
    "typecheck": "tsc -p ./tsconfig.json",
    "dev": "bun --watch run build.ts",
    "build": "bun run build.ts && tsc -p tsconfig.build.json",
    "test": "bun test"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^17.4.7",
    "@hcaptcha/types": "^1.0.3",
    "typescript": "^5.4.5"
  },
  "keywords": [
    "captcha",
    "hcaptcha",
    "stopbots",
    "webcomponent",
    "client",
    "vanilla",
    "vanilla.js",
    "vue",
    "vue.js",
    "preact",
    "react",
    "react.js",
    "nextjs",
    "next.js"
  ]
}
